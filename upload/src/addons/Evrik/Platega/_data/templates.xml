<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="admin" title="payment_profile_evrikPlatega" version_id="1000031" version_string="1.0.0 Beta 1"><![CDATA[<xf:inforow>{{ phrase('evrik_platega_notice') }}</xf:inforow>
<xf:textboxrow name="options[merchant_id]" value="{$profile.options.merchant_id}"
    label="{{ phrase('evrik_platega_merchant') }}" required="true" />
<xf:textboxrow name="options[secret]" value="{$profile.options.secret}" type="password" autocomplete="new-password"
    label="{{ phrase('evrik_platega_secret') }}" explain="{{ phrase('evrik_platega_secret_explain') }}" required="true" />
<xf:selectrow name="options[payment_method]" value="{{ $profile.options.payment_method ?: 0 }}"
    label="{{ phrase('evrik_platega_method') }}" explain="{{ phrase('evrik_platega_method_explain') }}">
    <xf:option value="0">{{ phrase('evrik_platega_method_auto') }}</xf:option>
    <xf:option value="2">{{ phrase('evrik_platega_method_2') }}</xf:option>
    <xf:option value="3">{{ phrase('evrik_platega_method_3') }}</xf:option>
    <xf:option value="11">{{ phrase('evrik_platega_method_11') }}</xf:option>
    <xf:option value="12">{{ phrase('evrik_platega_method_12') }}</xf:option>
    <xf:option value="13">{{ phrase('evrik_platega_method_13') }}</xf:option>
    <xf:option value="14">{{ phrase('evrik_platega_method_14') }}</xf:option>
</xf:selectrow>
<xf:textboxrow value="{$callbackUrl}" readonly="true"
    label="{{ phrase('evrik_platega_callback') }}" explain="{{ phrase('evrik_platega_callback_explain') }}" />
<xf:inforow><a href="{{ link('evrik-platega') }}">{{ phrase('evrik_platega_payments') }}</a></xf:inforow>]]></template>
  <template type="admin" title="evrik_platega_payments" version_id="1000033" version_string="1.0.0 Beta 3"><![CDATA[<xf:title>{{ phrase('evrik_platega_payments') }}</xf:title>
<xf:form action="{{ link('evrik-platega') }}" method="get" class="block">
    <div class="block-container"><h2 class="block-header">{{ phrase('evrik_platega_filters') }}</h2><div class="block-body">
        <xf:textboxrow name="search" value="{$search}" label="{{ phrase('evrik_platega_search') }}" />
        <xf:selectrow name="status" value="{$status}" label="{{ phrase('evrik_platega_filter_status') }}">
            <xf:option value="">{{ phrase('evrik_platega_all') }}</xf:option>
            <xf:foreach loop="$statuses" value="$statusOption">
                <xf:option value="{$statusOption}">{$statusOption}</xf:option>
            </xf:foreach>
        </xf:selectrow>
        <xf:selectrow name="profile" value="{$profileId}" label="{{ phrase('evrik_platega_filter_profile') }}">
            <xf:option value="0">{{ phrase('evrik_platega_all') }}</xf:option>
            <xf:foreach loop="$profiles" value="$profile">
                <xf:option value="{$profile.payment_profile_id}">{$profile.title}</xf:option>
            </xf:foreach>
        </xf:selectrow>
        <xf:submitrow submit="{{ phrase('evrik_platega_search_button') }}" />
    </div></div>
</xf:form>
<div class="block"><div class="block-container">
    <h2 class="block-header">{{ phrase('evrik_platega_summary') }}</h2>
    <div class="block-body"><div class="block-row">
        <xf:foreach loop="$summary" key="$summaryStatus" value="$summaryTotal">
            <a href="{{ link('evrik-platega', null, {'status': $summaryStatus}) }}" class="label label--subtle">{$summaryStatus}: {{ number($summaryTotal) }}</a>
        </xf:foreach>
    </div></div>
</div></div>
<div class="block"><div class="block-container"><div class="block-body">
    <xf:if is="$invoices">
        <div class="block-body block-body--scrollable">
        <table class="dataList"><thead><tr class="dataList-row dataList-row--header">
            <th class="dataList-cell">{{ phrase('evrik_platega_request_key') }}</th>
            <th class="dataList-cell">{{ phrase('evrik_platega_transaction_id') }}</th>
            <th class="dataList-cell">{{ phrase('evrik_platega_profile') }}</th>
            <th class="dataList-cell">{{ phrase('evrik_platega_amount') }}</th>
            <th class="dataList-cell">{{ phrase('evrik_platega_local_status') }}</th>
            <th class="dataList-cell">{{ phrase('evrik_platega_date') }}</th>
            <th class="dataList-cell">{{ phrase('evrik_platega_updated') }}</th>
        </tr></thead><tbody>
        <xf:foreach loop="$invoices" value="$invoice">
            <tr class="dataList-row">
                <td class="dataList-cell"><a href="{{ link('evrik-platega', null, {'request_key': $invoice.request_key, 'transaction_id': $invoice.transaction_id}) }}#manual-check" title="{{ phrase('evrik_platega_open_manual') }}"><code>{$invoice.request_key}</code></a></td>
                <td class="dataList-cell">{$invoice.transaction_id}</td>
                <td class="dataList-cell">{$invoice.profile_title}</td>
                <td class="dataList-cell">{{ number($invoice.amount_minor / 100, 2) }} {$invoice.currency}</td>
                <td class="dataList-cell">{$invoice.status}</td>
                <td class="dataList-cell"><xf:date time="{$invoice.created_date}" /></td>
                <td class="dataList-cell"><xf:date time="{$invoice.updated_date}" /></td>
            </tr>
        </xf:foreach>
        </tbody></table></div>
    <xf:else />
        <div class="block-row">{{ phrase('evrik_platega_empty') }}</div>
    </xf:if>
</div></div>
<xf:pagenav page="$page" perpage="$perPage" total="$total" link="evrik-platega"
    params="{{ {'search': $search, 'status': $status, 'profile': $profileId} }}" wrapperclass="block-outer" />
</div>
<xf:form action="{{ link('evrik-platega/check') }}" class="block" id="manual-check">
    <div class="block-container"><h2 class="block-header">{{ phrase('evrik_platega_manual_check') }}</h2><div class="block-body">
        <xf:inforow>{{ phrase('evrik_platega_manual_intro') }}</xf:inforow>
        <xf:textboxrow name="request_key" value="{$manualRequestKey}" required="true" maxlength="32" label="{{ phrase('evrik_platega_request_key') }}" />
        <xf:textboxrow name="transaction_id" value="{$manualTransactionId}" maxlength="36" label="{{ phrase('evrik_platega_transaction_id') }}" explain="{{ phrase('evrik_platega_transaction_help') }}" />
        <xf:submitrow submit="{{ phrase('evrik_platega_manual_check') }}" />
    </div></div>
</xf:form>
<xf:if is="$profiles is not empty">
<xf:form action="{{ link('evrik-platega/connection') }}" class="block">
    <div class="block-container"><h2 class="block-header">{{ phrase('evrik_platega_connection') }}</h2><div class="block-body">
        <xf:selectrow name="payment_profile_id" label="{{ phrase('evrik_platega_profile') }}">
            <xf:foreach loop="$profiles" value="$profile"><xf:option value="{$profile.payment_profile_id}">{$profile.title}</xf:option></xf:foreach>
        </xf:selectrow>
        <xf:inforow>{{ phrase('evrik_platega_connection_note') }}</xf:inforow>
        <xf:submitrow submit="{{ phrase('evrik_platega_connection') }}" />
    </div></div>
</xf:form>
</xf:if>]]></template>
  <template type="admin" title="evrik_platega_result" version_id="1000032" version_string="1.0.0 Beta 2"><![CDATA[<xf:title>{{ phrase('evrik_platega_result') }}</xf:title>
<div class="block"><div class="block-container"><div class="block-body">
    <div class="block-row"><xf:if is="$failed">{{ phrase('evrik_platega_result_failed') }}<xf:else />{{ phrase('evrik_platega_result_ok') }}</xf:if></div>
    <xf:formrow label="{{ phrase('evrik_platega_request_key') }}"><code>{$requestKey}</code></xf:formrow>
    <xf:formrow label="{{ phrase('evrik_platega_remote_status') }}">{$remoteStatus}</xf:formrow>
    <div class="block-row">{$message}</div>
    <div class="block-row"><xf:button href="{{ link('evrik-platega') }}">{{ phrase('evrik_platega_back') }}</xf:button></div>
</div></div></div>]]></template>
</templates>
